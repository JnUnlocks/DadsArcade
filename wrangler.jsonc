{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The worker's name becomes the first label of the URL, so this is
  // deliberately short: play.hyperdrive-arcade.workers.dev
  "name": "play",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-04",

  // One Worker serves both the built PWA and the API. Cloudflare now steers
  // new projects here rather than Pages, and it means no CORS and one deploy.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Let the Worker handle /api/* before the static asset router sees it.
    // /admin is also worker-served (worker/admin-page.ts): it isn't a built
    // asset, so without this the SPA fallback would answer with index.html.
    "run_worker_first": ["/api/*", "/admin"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyperdrive-arcade",
      // Filled in by `wrangler d1 create hyperdrive-arcade`.
      "database_id": "52a2a764-e0ea-4980-af4e-113154829596"
    }
  ],

  // Per-IP cap on every write (scores, plays, feedback). Keyed on the
  // connecting IP in worker/index.ts. 30 a minute is far above what a family
  // on one wifi does, and stops one script from spending the day's free D1
  // allowance. namespace_id is just a label unique to this account.
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
